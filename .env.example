# Copy this file to .env and fill in ONE key. .env is gitignored; never commit it.
#
# You only need a key if you have no local model. The offline path
# (BACKEND = "ollama" in config.py) needs no key at all.

# ---- NVIDIA (the default cloud provider: free key, no card) ----
# Get one at https://build.nvidia.com  -> keys look like nvapi-xxxxxxxx
NVIDIA_API_KEY=

# ---- Other hosts, if you prefer one of these ----
# Set CLOUD_PROVIDER in config.py to match whichever key you fill in.
# GROQ_API_KEY=                 # console.groq.com/keys
# OPENROUTER_API_KEY=           # openrouter.ai/keys  (has :free models)
# TOGETHER_API_KEY=
# OPENAI_API_KEY=
# CLOUD_API_KEY=                # works for any provider, if you prefer one name

# ---- Google Gemini / Gemma API (the older backend) ----
# GEMINI_API_KEY=

# ---- Optional: set these here instead of editing config.py ----
# BACKEND=auto                  # auto | ollama | cloud | gemini
# CLOUD_PROVIDER=nvidia         # nvidia | groq | openrouter | together | openai | local
# CLOUD_MODEL=                  # blank = the provider's default Gemma model
# CLOUD_BASE_URL=               # blank = the provider's normal URL
# OPEN_BROWSER=1                # 0 to run headless (the page is still served)
